            "x1": 34.0,
            "y1": 389.0,
            "x2": 201.0,
            "y2": 405.0
          },
          "source_id": null,
          "text": "전월 이용금액대별 월 할인한도"
        },
        {
          "block_id": "p2_b005",
          "type": "table",
          "bbox": {
            "x1": 34.0,
            "y1": 411.0,
            "x2": 458.0,
            "y2": 470.0
