PICKCARDU_ENV=development
PICKCARDU_PUBLIC_OPERATION_APPROVED=false
PICKCARDU_DB_PATH=services/rag-api/data/pickcardu.sqlite3
PICKCARDU_INDEX_RUNTIME_ROOT=data/rag/runtime
PICKCARDU_ALLOWED_ORIGINS=http://localhost:5173
PICKCARDU_COOKIE_SECURE=false
PICKCARDU_ALLOW_MISSING_ORIGIN_FOR_TESTS=false
PICKCARDU_SEED_ACCOUNTS_JSON=[{"username":"local-user","password":"replace-me","role":"user"},{"username":"local-developer","password":"replace-me","role":"developer"}]
PICKCARDU_EMBEDDING_MODEL=text-embedding-3-small
PICKCARDU_LLM_MODEL=gpt-5.6-luna
PICKCARDU_BGE_MODEL_PATH=.cache/reranker/bge-reranker-v2-m3
PICKCARDU_GTE_MODEL_PATH=
PICKCARDU_GTE_ALLOW_CUSTOM_CODE=false
OPENAI_API_KEY=
